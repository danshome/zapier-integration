# InnoVint personal access token for the connection
API_KEY=your_personal_access_token_here

# Integration tests (npm run test:integration) talk to the live InnoVint API.
TEST_API_KEY=personal_access_token_for_tests
TEST_BASEURL=https://sutter.innovint.us
# A TEST winery, never production: the Case Goods Adjustment test records a real adjustment.
TEST_WINERYID=wnry_YOURTESTWINERYID0000000
TEST_CASEGOODSNAMES=Not A Lot,CG-YOURTESTLOT1
TEST_BOTTLEQUANTITIES=1,1
TEST_COMPLIANCE=REMOVED_TAXPAID
# Leave unset to use "now".
# TEST_EFFECTIVEAT=2026-09-17T16:41:00Z
# The write test only runs when this is exactly "yes".
INNOVINT_ALLOW_TEST_WRITES=no
