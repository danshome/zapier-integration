{
  "name": "zapier-innovint-connector",
  "version": "1.1.0",
  "description": "Innovint Zapier Integration is an open-source integration connecting Zapier with the Innovint API, enabling users to create automated workflows between Innovint and various other applications supported by Zapier.",
  "repository": "danshome/zapier-integration",
  "author": "Dan McLaughlin <dan@danshome.net>",
  "license": "MIT License",
  "main": "index.js",
  "scripts": {
    "preversion": "git pull && npm run validate",
    "postversion": "git push && git push --tags",
    "test": "mocha --recursive -t 10000 -r dotenv/config -r ./test/_setup.js \"test/unit/**/*.js\"",
    "test:integration": "mocha --recursive -t 60000 -r dotenv/config \"test/integration/**/*.js\"",
    "test:all": "npm test && npm run test:integration",
    "replay:dry-run": "node scripts/replay-dry-run.js",
    "deploy": "npm run validate && zapier-platform push",
    "precommit": "lint-staged",
    "validate": "npm run test && npm run lint && zapier-platform validate --without-style",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "env": "zapier-platform env:set $npm_package_version ${npm_config_var}=${npm_config_val}",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "dependencies": {
    "zapier-platform-core": "19.1.0"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "eslint": "~8.57.0",
    "eslint-config-google": "~0.14.0",
    "eslint-config-prettier": "~9.1.0",
    "eslint-config-standard": "~17.1.0",
    "eslint-plugin-import": "~2.29.1",
    "eslint-plugin-mocha": "~10.4.3",
    "eslint-plugin-n": "~16.6.2",
    "eslint-plugin-promise": "~6.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "mocha": "^12.0.2",
    "nock": "^14.0.17",
    "npm-check-updates": "^23.1.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.7",
    "should": "~13.2.3",
    "zapier-platform-cli": "^19.1.0"
  },
  "prettier": {
    "singleQuote": true
  },
  "private": true,
  "overrides": {
    "form-data": "^4.0.6",
    "adm-zip": "^0.6.1",
    "tmp": "^0.2.7",
    "yeoman-environment": "^6.3.0",
    "inquirer@8": "^8.2.7"
  }
}
